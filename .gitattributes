# Shell scripts must check out with LF line endings: they run on Linux/WSL (and
# the *.sh.jinja templates render into generated projects), where a CRLF shebang
# (`#!/usr/bin/env bash\r`) and trailing carriage returns on every line break the
# script. eol=lf overrides core.autocrlf=true on Windows checkouts.
*.sh        text eol=lf
*.bash      text eol=lf
*.sh.jinja  text eol=lf

# The vendored Mermaid bundle is redistributed byte-for-byte as upstream
# publishes it; any line-ending conversion breaks that claim (and bloats it by
# one byte per line). binary = -text -diff -merge.
docs/assets/mermaid.min.js  binary

# Vendored woff2 font files are binary; without this, a checkout that treats
# them as text can corrupt them via line-ending conversion.
*.woff2  binary

# The scripted terminal demo (docs/assets/demo/) is regenerated by the demo
# workflow from scripts/record_demo.py; the gif it renders is an opaque
# binary.
*.gif    binary

# asciicast v2 files are newline-delimited JSON, one event per line; the
# recorder writes them with explicit LF line endings so the checked-out file
# matches the byte count CI reports. eol=lf overrides core.autocrlf=true on
# Windows checkouts.
*.cast   text eol=lf
