"""Service logic for generating greetings."""

from {{ package_name }}.models.greeter import GreeterInput


class GreeterService:
    """Business logic for generating greeting messages."""

    def greet(self, data: GreeterInput) -> str:
        """Generates a personalized greeting.

        Args:
            data: A GreeterInput object containing the user's name.

        Returns:
            A formatted greeting string.
        """
        name = data.name.strip()
        return f"Welcome, {name}!" if name else "Welcome!"
