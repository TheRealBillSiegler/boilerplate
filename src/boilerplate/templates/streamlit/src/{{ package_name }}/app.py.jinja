"""Shows the project's own dependency stack, read from `uv.lock`.

Displays how many packages are locked, how many are direct runtime or
development dependencies, how many are transitive, and which packages the
most others depend on. Run it with:

    streamlit run src/{{ package_name }}/app.py

Or press F5 in VS Code to launch it under the debugger.
"""

from pathlib import Path
from typing import Final

import streamlit as st
from pydantic import ValidationError

from {{ package_name }}.adapters.lockfile import read_lockfile
from {{ package_name }}.models.stack_filter import StackFilter
from {{ package_name }}.services.inventory import (
    apply_filter,
    build_rows,
    summarize,
    top_dependents,
)

LOCKFILE: Final = Path(__file__).resolve().parents[2] / "uv.lock"


def main() -> None:
    """Renders the stack inventory page."""
    st.set_page_config(page_title="{{ project_name }}", page_icon="🧱")
    st.title("{{ project_name }}")
    st.caption("Reads this project's own `uv.lock`.")

    try:
        project, packages = read_lockfile(LOCKFILE)
    except FileNotFoundError:
        st.error("uv.lock not found next to pyproject.toml. Run uv sync, then reload.")
        st.stop()

    rows = build_rows(project, packages)
    summary = summarize(rows)

    total_col, runtime_col, dev_col, transitive_col = st.columns(4)
    total_col.metric("Locked packages", summary.total)
    runtime_col.metric("Runtime", summary.runtime)
    dev_col.metric("Dev", summary.dev)
    transitive_col.metric("Transitive", summary.transitive)

    search = st.text_input("Filter by name", placeholder="e.g. pydantic")
    scope = st.selectbox("Scope", ("all", "runtime", "dev", "transitive"))
    limit = st.number_input("Rows", min_value=1, max_value=500, value=50, step=10)

    try:
        stack_filter = StackFilter.model_validate(
            {"search": search, "scope": scope, "limit": limit}
        )
    except ValidationError as error:
        st.warning(error.errors()[0]["msg"])
        st.stop()

    filtered = apply_filter(rows, stack_filter)
    st.dataframe([row.model_dump() for row in filtered], hide_index=True)

    st.subheader("Most depended on")
    top = top_dependents(rows)
    st.bar_chart(
        {
            "package": [row.name for row in top],
            "dependents": [row.dependents for row in top],
        },
        x="package",
        y="dependents",
    )


if __name__ == "__main__":
    main()
