#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# build-container.sh
#
# Description:
#   Builds a Docker image for the project. When the project's default
#   package index needs credentials, the image build reads them from a
#   Docker secret so they never land in an image layer.
#
# Requirements:
#   - Docker, reachable directly or via sudo.
# ==============================================================================

# ------------------------------------------------------------------------------
# Terminal colors
# ------------------------------------------------------------------------------
RESET="\033[0m"
BOLD="\033[1m"
BLUE="\033[1;34m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"

# ------------------------------------------------------------------------------
# Usage
# ------------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: $(basename "$0") [-i|--image-name <name:tag>] [-h|--help]

Options:
  -i, --image-name   Docker image name (e.g. "my-app:latest").
                     If omitted, defaults to '<project-name>:local' from pyproject.toml.
  -h, --help         Show this help message.
EOF
}

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------
get_project_name_from_pyproject() {
    if [[ -f pyproject.toml ]]; then
        awk -F '"' '/^\s*name\s*=\s*"/ { print $2; exit }' pyproject.toml | tr '_' '-'
    else
        return 1
    fi
}

# ------------------------------------------------------------------------------
# Parse arguments
# ------------------------------------------------------------------------------
IMAGE_NAME=""
while [[ $# -gt 0 ]]; do
    case "$1" in
    -i | --image-name)
        IMAGE_NAME="$2"
        shift 2
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo -e "${RED}❌ Unknown option: $1${RESET}"
        usage
        exit 1
        ;;
    esac
done

# ------------------------------------------------------------------------------
# Environment validation
# ------------------------------------------------------------------------------
if [ ! -f uv.lock ]; then
    echo -e "${RED}❌ Required file 'uv.lock' not found.${RESET}"
    exit 1
fi

if ! command -v docker &>/dev/null; then
    echo -e "${RED}❌ Required tool 'docker' is not installed or not in PATH.${RESET}"
    exit 1
fi
{%- if package_index_url and ('dev.azure.com' in package_index_url or 'pkgs.visualstudio.com' in package_index_url) %}

if ! command -v az &>/dev/null; then
    echo -e "${RED}❌ Required tool 'az' is not installed or not in PATH.${RESET}"
    exit 1
fi
{%- endif %}

# ------------------------------------------------------------------------------
# Docker access
# ------------------------------------------------------------------------------
if docker info >/dev/null 2>&1; then
    DOCKER=(docker)
elif sudo -n docker info >/dev/null 2>&1 || sudo -v >/dev/null 2>&1; then
    DOCKER=(sudo docker)
else
    echo -e "${RED}❌ Cannot reach the Docker daemon. Start Docker, or ask an administrator to grant your account access to it.${RESET}"
    exit 1
fi

# ------------------------------------------------------------------------------
# Resolve image name
# ------------------------------------------------------------------------------
if [[ -z "$IMAGE_NAME" ]]; then
    PROJECT_NAME=$(get_project_name_from_pyproject) || {
        echo -e "${RED}❌ No image name provided and pyproject.toml not found.${RESET}"
        exit 1
    }
    IMAGE_NAME="${PROJECT_NAME}:local"
    echo -e "${YELLOW}ℹ️  Using default image name: ${IMAGE_NAME}${RESET}"
fi

{% if not package_index_url -%}
# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------
echo -e "${BLUE}${BOLD}🐳 Building Docker image '$IMAGE_NAME'...${RESET}"
"${DOCKER[@]}" buildx build --tag "$IMAGE_NAME" --load .
{%- else %}
{%- if 'dev.azure.com' in package_index_url or 'pkgs.visualstudio.com' in package_index_url %}
# ------------------------------------------------------------------------------
# Azure DevOps AAD authentication
# ------------------------------------------------------------------------------
DEVOPS_RESOURCE="499b84ac-1321-427f-aa17-267ca6975798"
echo -e "${BLUE}${BOLD}🔐 Verifying Azure session for Azure DevOps access...${RESET}"
if ! az account get-access-token --resource "$DEVOPS_RESOURCE" --query accessToken -o tsv &>/dev/null; then
    echo -e "${YELLOW}🔑 Session expired or not authenticated. Logging in...${RESET}"
    az login --scope "$DEVOPS_RESOURCE//.default" || {
        echo -e "${RED}❌ Azure login failed. Unable to proceed.${RESET}"
        exit 1
    }
fi

TOKEN=$(az account get-access-token \
    --resource "$DEVOPS_RESOURCE" \
    --query accessToken -o tsv | tr -d '\r\n')

if [[ -z "$TOKEN" ]]; then
    echo -e "${RED}❌ Failed to obtain Azure DevOps token.${RESET}"
    exit 1
fi

INDEX_SECRET="https://AzureDevOps:$TOKEN@{{ package_index_url | replace('https://', '') | replace('http://', '') }}"
{%- else %}
if [[ -z "${INDEX_URL:-}" ]]; then
    echo -e "${RED}❌ Set INDEX_URL to the package index URL with credentials embedded (e.g. https://user:token@host/simple/).${RESET}"
    exit 1
fi

INDEX_SECRET="$INDEX_URL"
{%- endif %}

# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------
# sudo drops the caller's environment, so the index secret reaches docker through env either way.
if [[ "${DOCKER[0]}" == "sudo" ]]; then
    BUILD=(sudo env "INDEX=$INDEX_SECRET" docker)
else
    BUILD=(env "INDEX=$INDEX_SECRET" docker)
fi

echo -e "${BLUE}${BOLD}🐳 Building Docker image '$IMAGE_NAME'...${RESET}"
"${BUILD[@]}" buildx build --secret id=index,env=INDEX --tag "$IMAGE_NAME" --load .
{%- endif %}

echo -e "${GREEN}✅ Docker image built successfully: ${IMAGE_NAME}${RESET}"

echo -e "${BLUE}${BOLD}ℹ️  To run your container locally:${RESET}"
echo -e "${YELLOW}   ${DOCKER[*]} run -p 8501:8501 ${IMAGE_NAME}${RESET}"
echo -e "${BLUE}${BOLD}📣  Note:${RESET} ${YELLOW}If your app runs on a different port, update the -p flag accordingly.${RESET}"
