#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# push-container.sh
#
# Description:
#   Re-tags and pushes a local Docker image to a container registry.
#   Authentication is chosen at runtime from the registry hostname.
#
# Requirements:
#   - Docker, reachable directly or via sudo.
#   - Azure CLI, only when pushing to an Azure Container Registry.
# ==============================================================================

# ------------------------------------------------------------------------------
# Terminal colors
# ------------------------------------------------------------------------------
RESET="\033[0m"
BOLD="\033[1m"
BLUE="\033[1;34m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"

# ------------------------------------------------------------------------------
# Usage
# ------------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: $(basename "$0") [-i <image:tag>] [-r <registry>] [-n <namespace>] [-t <remote-tag>] [-h]

Options:
  -i, --image-name   Local Docker image (default: <project-name>:local)
  -r, --registry     Registry hostname (default: {{ container_registry }})
  -n, --namespace    Owner or organization within the registry (default: \$CONTAINER_NAMESPACE)
  -t, --tag          Remote image tag (default: latest)
  -h, --help         Show this help message
EOF
}

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------
# POSIX character classes, not GNU's \s: mawk (Ubuntu's default awk) reads
# \s as a literal 's'. Fails when pyproject.toml or its name is missing.
get_project_name_from_pyproject() {
    local name
    [[ -f pyproject.toml ]] || return 1
    name=$(awk -F '"' '/^[[:space:]]*name[[:space:]]*=[[:space:]]*"/ { print $2; exit }' pyproject.toml | tr '_' '-')
    [[ -n "$name" ]] || return 1
    printf '%s\n' "$name"
}

# ------------------------------------------------------------------------------
# Parse arguments
# ------------------------------------------------------------------------------
REGISTRY="{{ container_registry }}"
NAMESPACE="${CONTAINER_NAMESPACE:-}"
REMOTE_TAG="latest"
LOCAL_IMAGE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
    -i | --image-name)
        LOCAL_IMAGE="$2"
        shift 2
        ;;
    -r | --registry)
        REGISTRY="$2"
        shift 2
        ;;
    -n | --namespace)
        NAMESPACE="$2"
        shift 2
        ;;
    -t | --tag)
        REMOTE_TAG="$2"
        shift 2
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo -e "${RED}❌ Unknown option: $1${RESET}"
        usage
        exit 1
        ;;
    esac
done

# ------------------------------------------------------------------------------
# Validate tools
# ------------------------------------------------------------------------------
if ! command -v docker &>/dev/null; then
    echo -e "${RED}❌ Required tool 'docker' is not installed or not in PATH.${RESET}"
    exit 1
fi

# ------------------------------------------------------------------------------
# Docker access
# ------------------------------------------------------------------------------
if docker info >/dev/null 2>&1; then
    DOCKER=(docker)
elif sudo -n docker info >/dev/null 2>&1 || sudo -v >/dev/null 2>&1; then
    DOCKER=(sudo docker)
else
    echo -e "${RED}❌ Cannot reach the Docker daemon. Start Docker, or ask an administrator to grant your account access to it.${RESET}"
    exit 1
fi

# ------------------------------------------------------------------------------
# Infer image name
# ------------------------------------------------------------------------------
if [[ -z "$LOCAL_IMAGE" ]]; then
    PROJECT_NAME=$(get_project_name_from_pyproject) || {
        echo -e "${RED}❌ Image name not provided, and no project name was found in pyproject.toml.${RESET}"
        exit 1
    }
    LOCAL_IMAGE="${PROJECT_NAME}:local"
    echo -e "${YELLOW}ℹ️  Using default image name: ${LOCAL_IMAGE}${RESET}"
fi

# ------------------------------------------------------------------------------
# Check local Docker image exists
# ------------------------------------------------------------------------------
if ! "${DOCKER[@]}" image inspect "$LOCAL_IMAGE" &>/dev/null; then
    echo -e "${RED}❌ Local image '$LOCAL_IMAGE' not found. Run ./scripts/build-container.sh first.${RESET}"
    exit 1
fi

# ------------------------------------------------------------------------------
# Registry authentication
# ------------------------------------------------------------------------------
case "$REGISTRY" in
*.azurecr.io)
    if ! command -v az &>/dev/null; then
        echo -e "${RED}❌ Required tool 'az' is not installed or not in PATH.${RESET}"
        exit 1
    fi

    if ! az account show &>/dev/null; then
        echo -e "${YELLOW}🔐 Not logged into Azure CLI. Logging in...${RESET}"
        az login || {
            echo -e "${RED}❌ Azure login failed.${RESET}"
            exit 1
        }
    fi

    ACR_REGISTRY_NAME="${REGISTRY%%.azurecr.io}"
    echo -e "${BLUE}${BOLD}🔐 Acquiring AAD token for '$ACR_REGISTRY_NAME'...${RESET}"

    TOKEN=$(az acr login \
        --name "$ACR_REGISTRY_NAME" \
        --expose-token \
        --query accessToken \
        -o tsv 2> >(grep -v "manual login" >&2)) || {
        echo -e "${RED}❌ Failed to obtain ACR token.${RESET}"
        exit 1
    }

    echo -e "${BLUE}${BOLD}🔐 Logging Docker into '$REGISTRY'...${RESET}"
    echo "$TOKEN" | "${DOCKER[@]}" login "$REGISTRY" \
        --username 00000000-0000-0000-0000-000000000000 \
        --password-stdin
    ;;
ghcr.io | docker.io)
    if [[ -z "$NAMESPACE" ]]; then
        echo -e "${RED}❌ Set -n/--namespace (or \$CONTAINER_NAMESPACE) to the owner or organization the image belongs to on '$REGISTRY'.${RESET}"
        exit 1
    fi

    if [[ -n "${REGISTRY_TOKEN:-}" ]]; then
        echo -e "${BLUE}${BOLD}🔐 Logging Docker into '$REGISTRY'...${RESET}"
        echo "$REGISTRY_TOKEN" | "${DOCKER[@]}" login "$REGISTRY" \
            --username "$NAMESPACE" \
            --password-stdin
    else
        echo -e "${YELLOW}ℹ️  \$REGISTRY_TOKEN not set; assuming an existing 'docker login $REGISTRY' session.${RESET}"
    fi
    ;;
*)
    echo -e "${YELLOW}ℹ️  Assuming an existing 'docker login $REGISTRY' session.${RESET}"
    ;;
esac

# ------------------------------------------------------------------------------
# Tag and push image
# ------------------------------------------------------------------------------
REPO_NAME="${LOCAL_IMAGE%%:*}"
if [[ -n "$NAMESPACE" ]]; then
    REMOTE_IMAGE="${REGISTRY}/${NAMESPACE}/${REPO_NAME}:${REMOTE_TAG}"
else
    REMOTE_IMAGE="${REGISTRY}/${REPO_NAME}:${REMOTE_TAG}"
fi

echo -e "${BLUE}${BOLD}🔄 Tagging '$LOCAL_IMAGE' → '$REMOTE_IMAGE'...${RESET}"
"${DOCKER[@]}" tag "$LOCAL_IMAGE" "$REMOTE_IMAGE"

echo -e "${BLUE}${BOLD}🚀 Pushing to $REGISTRY: $REMOTE_IMAGE...${RESET}"
"${DOCKER[@]}" push "$REMOTE_IMAGE"

echo -e "${GREEN}${BOLD}✅ Image pushed successfully: $REMOTE_IMAGE${RESET}"
