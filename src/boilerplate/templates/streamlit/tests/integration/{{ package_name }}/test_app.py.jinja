"""Smoke test for the Streamlit app, run with Streamlit's in-process test harness."""

from pathlib import Path

from streamlit.testing.v1 import AppTest

APP_PATH = Path(__file__).resolve().parents[3] / "src" / "{{ package_name }}" / "app.py"


def test_app_runs_without_exception() -> None:
    """Verifies the app renders without raising."""
    at = AppTest.from_file(str(APP_PATH))
    at.run(timeout=10)
    assert not at.exception


def test_greeter_flow_renders_a_visible_greeting() -> None:
    """Verifies entering a name renders a visible greeting from the greeter."""
    at = AppTest.from_file(str(APP_PATH))
    at.run(timeout=10)
    at.text_input[0].set_value("Ada").run(timeout=10)
    assert not at.exception
    assert "Welcome, Ada!" in at.success[0].value
