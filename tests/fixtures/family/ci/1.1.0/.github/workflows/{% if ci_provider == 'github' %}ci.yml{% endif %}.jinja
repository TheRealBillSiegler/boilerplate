name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: astral-sh/setup-uv@v5
      - name: Install Python
        run: uv python install {{ python_version }}
      - name: Install dependencies
        run: uv sync
      - name: Run the tests
        run: uv run pytest
